<%- include('partials/top', { title }) %>

<section class="page-heading">
  <div>
    <p class="eyebrow"><%= mode === 'create' ? 'New log entry' : `Entry #${issue.id}` %></p>
    <h1><%= title %></h1>
    <% if (mode === 'edit') { %>
      <p class="meta-line">Submitted <%- localTime(issue.created_at) %> · Updated <%- localTime(issue.updated_at) %></p>
    <% } %>
  </div>
  <a class="ghost-button compact" href="<%= urlFor('/') %>">Back</a>
</section>

<form class="form-card stack" method="post" action="<%= urlFor(action) %>" enctype="multipart/form-data" data-editor-form data-max-files="12" data-max-file-size="10485760">
  <%- include('partials/csrf') %>
  <% if (mode === 'edit') { %>
    <input type="hidden" name="base_updated_at" value="<%= issue.updated_at %>">
  <% } %>

  <div class="form-error" role="alert" data-form-error hidden></div>

  <div class="field">
    <label for="poster_name">Name</label>
    <input id="poster_name" name="poster_name" type="text" value="<%= issue.poster_name || '' %>" maxlength="120" autocomplete="name" required>
  </div>

  <div class="field">
    <label for="status">Status</label>
    <select id="status" name="status" required>
      <option value="pending" <%= (issue.status || 'pending') === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="resolved" <%= issue.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
    </select>
  </div>

  <fieldset class="checkbox-panel" data-department-group>
    <legend>Departments</legend>
    <div class="checkbox-grid">
      <% departments.forEach((department) => { %>
        <label class="checkbox-card">
          <input type="checkbox" name="department_ids" value="<%= department.id %>" <%= (issue.department_ids || []).includes(department.id) ? 'checked' : '' %>>
          <span><%= department.name %></span>
        </label>
      <% }) %>
    </div>
  </fieldset>

  <div class="field">
    <label>Issue</label>
    <%- include('partials/editor', {
      label: 'Issue',
      name: 'issue_html',
      value: issue.issue_html,
      placeholder: 'Describe what happened',
      required: true
    }) %>
  </div>

  <div class="field">
    <label>Resolution</label>
    <%- include('partials/editor', {
      label: 'Resolution',
      name: 'resolution_html',
      value: issue.resolution_html,
      placeholder: 'Add the fix or leave blank'
    }) %>
  </div>

  <% if (attachments.length > 0) { %>
    <section class="existing-attachments">
      <h2>Attachments</h2>
      <div class="attachment-grid">
        <% attachments.forEach((attachment) => { %>
          <label class="attachment-card">
            <% if (attachment.mime_type.startsWith('image/')) { %>
              <img src="<%= urlFor(`/uploads/${attachment.filename}`) %>" alt="">
            <% } else { %>
              <span class="pdf-icon">PDF</span>
            <% } %>
            <span><%= attachment.original_filename %></span>
            <span class="checkbox-line">
              <input type="checkbox" name="delete_attachment_ids" value="<%= attachment.id %>" data-confirm-checkbox>
              Delete
            </span>
          </label>
        <% }) %>
      </div>
    </section>
  <% } %>

  <div class="field">
    <label for="attachments">Add files</label>
    <input id="attachments" name="attachments" type="file" multiple accept="image/jpeg,image/png,image/gif,image/webp,application/pdf" data-attachment-input>
    <p class="field-hint">Images or PDFs, up to 12 files of 10 MB each. You can also paste a screenshot straight into the Issue or Resolution box.</p>
    <ul class="selected-files" data-attachment-list hidden></ul>
  </div>

  <div class="form-actions">
    <button class="primary-button" type="submit"><%= mode === 'create' ? 'Submit Issue' : 'Save Changes' %></button>
    <a class="ghost-button" href="<%= urlFor('/') %>">Cancel</a>
  </div>
</form>

<% if (mode === 'edit') { %>
  <form class="danger-zone" method="post" action="<%= urlFor(`/issues/${issue.id}/delete`) %>" data-confirm="Delete this issue and its attachments? This cannot be undone.">
    <%- include('partials/csrf') %>
    <button class="danger-button compact" type="submit">Delete Issue</button>
  </form>
<% } %>

<%- include('partials/bottom') %>
