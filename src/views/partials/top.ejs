<!doctype html>
<html lang="en" data-theme="<%= theme || 'dark' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' && title ? `${title} | ${displayTitle}` : displayTitle %></title>
    <link rel="icon" href="<%= faviconUrl %>">
    <link rel="apple-touch-icon" href="<%= faviconUrl %>">
    <link rel="stylesheet" href="<%= urlFor(`/css/styles.css?v=${assetVersion}`) %>">
    <script defer src="<%= urlFor(`/js/app.js?v=${assetVersion}`) %>"></script>
  </head>
  <body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
    <% if (isAuthenticated) { %>
      <header class="app-header">
        <a class="brand" href="<%= urlFor('/') %>" aria-label="<%= displayTitle %> dashboard">
          <% if (logoUrl) { %>
            <img class="brand-logo" src="<%= logoUrl %>" alt="<%= displayTitle %> logo">
            <span class="brand-title"><%= displayTitle %></span>
          <% } else { %>
            <span class="brand-wordmark"><%= displayTitle %></span>
          <% } %>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a class="<%= currentPath === '/' ? 'active' : '' %>" href="<%= urlFor('/') %>">Dashboard</a>
          <a class="<%= currentPath === '/issues/new' ? 'active' : '' %>" href="<%= urlFor('/issues/new') %>">Add Issue</a>
          <a class="<%= currentPath === '/settings' ? 'active' : '' %>" href="<%= urlFor('/settings') %>">Settings</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">Theme</button>
          <a class="logout-link" href="<%= urlFor('/logout') %>">Logout</a>
        </nav>
      </header>
    <% } %>
    <main class="<%= isAuthenticated ? 'page-shell' : 'login-shell' %>">
      <%- include('flash') %>
