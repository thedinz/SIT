{
  "name": "simple-issue-tracker",
  "version": "1.5.0",
  "description": "A simple self-hosted issue-and-resolution log for church production teams.",
  "main": "src/server.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/db.js && node --check src/sanitize.js && node --check src/library.js && node --check src/public/js/app.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.7.5",
    "content-disposition": "^0.5.4",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "sanitize-html": "^2.14.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
