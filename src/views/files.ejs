<%- include('partials/top', { title: 'Files' }) %>

<section class="page-heading">
  <div>
    <p class="eyebrow">Issue attachments</p>
    <h1>Files</h1>
    <p class="meta-line"><%= fileCount %> <%= fileCount === 1 ? 'file' : 'files' %> organized by department. Files from shared issues appear in each selected department.</p>
  </div>
  <a class="primary-button compact" href="<%= urlFor('/issues/new') %>">Add Issue</a>
</section>

<aside class="install-hint" data-install-hint hidden>
  <p data-install-text>Add Files to your home screen to open it like an app.</p>
  <div class="install-hint-actions">
    <button class="primary-button compact" type="button" data-install-button hidden>Install</button>
    <button class="secondary-button compact" type="button" data-install-dismiss>Not now</button>
  </div>
</aside>

<% if (fileCount === 0) { %>
  <section class="empty-state">
    <h2>No files yet</h2>
    <p>Upload images or PDFs when adding or editing an issue. They will appear here under the issue's departments.</p>
  </section>
<% } else { %>
  <div class="stack">
    <% departments.forEach((department) => { %>
      <section class="settings-card files-card" aria-labelledby="department-<%= department.id %>">
        <div class="files-department-heading">
          <h2 id="department-<%= department.id %>"><%= department.name %></h2>
          <span class="muted"><%= department.files.length %> <%= department.files.length === 1 ? 'file' : 'files' %></span>
        </div>
        <% if (department.files.length === 0) { %>
          <p class="muted">No files in this department yet.</p>
        <% } else { %>
          <ul class="files-list">
            <% department.files.forEach((file) => { %>
              <% const fileUrl = urlFor(`/uploads/${encodeURIComponent(file.filename)}`); %>
              <% const isPdf = file.mime_type === 'application/pdf'; %>
              <li class="file-row">
                <% if (isPdf) { %>
                  <span class="file-thumb file-thumb-pdf" aria-hidden="true">PDF</span>
                <% } else { %>
                  <img class="file-thumb" src="<%= fileUrl %>" alt="" loading="lazy" decoding="async">
                <% } %>
                <div class="file-details">
                  <a class="file-link" href="<%= fileUrl %>" target="_blank" rel="noopener noreferrer" <%- isPdf ? '' : 'data-viewer-image' %>><%= file.original_filename %></a>
                  <span class="muted"><%= isPdf ? 'PDF' : 'Image' %> &middot; <%= formatBytes(file.size) %> &middot; Uploaded <%- localTime(file.uploaded_at) %></span>
                </div>
                <a class="secondary-button compact" href="<%= urlFor(`/issues/${file.issue_id}/edit`) %>">Issue #<%= file.issue_id %></a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    <% }) %>
  </div>
<% } %>

<%- include('partials/bottom') %>
