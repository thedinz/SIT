<!doctype html>
<html lang="en" data-theme="<%= theme || 'dark' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' && title ? `${title} | ${appName}` : appName %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <script defer src="/js/app.js"></script>
  </head>
  <body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
    <% if (isAuthenticated) { %>
      <header class="app-header">
        <a class="brand" href="/" aria-label="<%= appName %> dashboard">
          <% if (logoUrl) { %>
            <img class="brand-logo" src="<%= logoUrl %>" alt="<%= appName %> logo">
            <span class="brand-title"><%= appName %></span>
          <% } else { %>
            <span class="brand-wordmark"><%= appName %></span>
          <% } %>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Dashboard</a>
          <a class="<%= currentPath === '/issues/new' ? 'active' : '' %>" href="/issues/new">Add Issue</a>
          <a class="<%= currentPath === '/settings' ? 'active' : '' %>" href="/settings">Settings</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">Theme</button>
          <a class="logout-link" href="/logout">Logout</a>
        </nav>
      </header>
    <% } %>
    <main class="<%= isAuthenticated ? 'page-shell' : 'login-shell' %>">
      <%- include('flash') %>
