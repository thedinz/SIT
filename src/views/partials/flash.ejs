<% if (flash) { %>
  <div class="toast toast-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>" data-toast <%= flash.sticky ? 'data-toast-sticky' : '' %>>
    <span><%= flash.message %></span>
    <button type="button" aria-label="Dismiss message" data-dismiss-toast>×</button>
  </div>
<% } %>
